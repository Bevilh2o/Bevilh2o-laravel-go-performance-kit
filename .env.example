# ==============================================================================
# Docker Compose Global Environment Variables
# ==============================================================================

# Project Name (used as container/network prefix)
COMPOSE_PROJECT_NAME=lgpk

# PostgreSQL Configuration
DB_PORT=5432
DB_DATABASE=lgpk_db
DB_USERNAME=lgpk_user
DB_PASSWORD=lgpk_secret

# Redis Configuration
REDIS_PORT=6379
REDIS_PASSWORD=null